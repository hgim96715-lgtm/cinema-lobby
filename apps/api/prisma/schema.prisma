// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

enum UserRole {
    user
    admin
}

model User {
    id              String           @id @default(uuid(7)) @db.Uuid
    email           String           @unique
    passwordHash    String           @map("password_hash")
    nickname        String           @unique
    role            UserRole         @default(user)
    createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
    tickets         Ticket[]
    userMovies      UserMovie[]
    reviewPosts     ReviewPost[]
    reviewPostLikes ReviewPostLike[]

    @@map("users")
}

enum UserMovieKind {
    wish
    watched
}

model UserMovie {
    id        String        @id @default(uuid(7)) @db.Uuid
    userId    String        @map("user_id") @db.Uuid
    tmdbId    Int           @map("tmdb_id")
    kind      UserMovieKind
    createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id])

    @@unique([userId, tmdbId, kind])
    @@map("user_movies")
}

enum TicketStatus {
    issued
    used
}

model Ticket {
    id         String       @id @default(uuid(7)) @db.Uuid
    userId     String       @map("user_id") @db.Uuid
    ticketDate DateTime     @map("ticket_date") @db.Date
    machineId  String?      @map("machine_id") @db.VarChar(32)
    tmdbId     Int?         @map("tmdb_id")
    status     TicketStatus
    issuedAt   DateTime?    @map("issued_at") @db.Timestamptz(3)
    usedAt     DateTime?    @map("used_at") @db.Timestamptz(3)
    createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id])

    @@unique([userId, ticketDate])
    @@map("tickets")
}

model MoviePool {
    id              String   @id @default(uuid(7)) @db.Uuid
    tmdbId          Int      @unique @map("tmdb_id")
    title           String
    overview        String   @db.Text
    posterPath      String?  @map("poster_path")
    releaseDate     String   @default("") @map("release_date")
    director        String?
    genreIds        Int[]    @default([]) @map("genre_ids")
    originCountries String[] @default([]) @map("origin_countries")
    syncedAt        DateTime @default(now()) @map("synced_at") @db.Timestamptz(3)

    @@map("movie_pool")
}

model ReviewPost {
    id        String   @id @default(uuid(7)) @db.Uuid
    userId    String   @map("user_id") @db.Uuid
    tmdbId    Int      @map("tmdb_id")
    body      String   @db.Text
    rating    Float
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    user            User             @relation(fields: [userId], references: [id])
    reviewPostLikes ReviewPostLike[]

    @@index([createdAt(sort: Desc)])
    @@map("review_posts")
}

model ReviewPostLike {
    id        String   @id @default(uuid(7)) @db.Uuid
    postId    String   @map("post_id") @db.Uuid
    userId    String   @map("user_id") @db.Uuid
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

    post ReviewPost @relation(fields: [postId], references: [id], onDelete: Cascade)
    user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([postId, userId])
    @@map("review_post_likes")
}
